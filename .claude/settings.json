{
  "permissions": {
    "allow": [
      "Bash(npx --no-install playwright-cli *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*credential*)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(npx --no-install playwright-cli run-code *)",
      "Bash(npx --no-install playwright-cli eval *)",
      "Bash(npx --no-install playwright-cli install *)",
      "Bash(npx --no-install playwright-cli attach *)",
      "Bash(npx --no-install playwright-cli route *)",
      "Bash(npx --no-install playwright-cli * --persistent*)",
      "Bash(npx --no-install playwright-cli * --profile*)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(Invoke-RestMethod *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "Bash(playwright-cli *)",
      "Bash(npx playwright *)",
      "Bash(npx --no-install playwright *)",
      "PowerShell(playwright-cli *)",
      "PowerShell(npx playwright *)",
      "Bash(npx playwright-cli *)",
      "PowerShell(npx playwright-cli *)",
      "Bash(npx --no-install playwright-cli open *)",
      "Bash(npx --no-install playwright-cli goto *)",
      "Bash(npx --no-install playwright-cli tab-new *)",
      "Bash(npx --no-install playwright-cli upload *)",
      "Bash(npx --no-install playwright-cli drop *)",
      "Bash(git commit *)"
    ]
  }
}
