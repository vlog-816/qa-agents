{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*credential*)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(Invoke-RestMethod *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "Bash(playwright-cli *)",
      "Bash(npx playwright *)",
      "Bash(npx --no-install playwright *)",
      "PowerShell(playwright-cli *)",
      "PowerShell(npx playwright *)",
      "Bash(git commit *)"
    ]
  }
}
