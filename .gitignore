# Test evidence may contain real data
workspace/**/evidence/
workspace/**/screenshots/

# Documents dropped into inbox may contain sensitive information
inbox/*
!inbox/.gitkeep

# Playwright test output (traces and screenshots go to workspace/**/evidence/, which is ignored above)
test-results/
playwright-report/
blob-report/

# Local tool installs and tool scratch output
node_modules/
.playwright-cli/

# Personal configuration and secrets
.claude/settings.local.json
CLAUDE.local.md
.env
.env.*
secrets/
